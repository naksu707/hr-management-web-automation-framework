{
  "name": "hr-management-web-automation-framework",
  "version": "1.0.0",
  "private": true,
  "description": "E2E test automation for OrangeHRM with Cypress and TypeScript",
  "author": "Maria Jose Ospina",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "cy:open": "cypress open --e2e",
    "test": "cypress run",
    "test:chrome": "cypress run --browser chrome",
    "test:firefox": "cypress run --browser firefox",
    "test:edge": "cypress run --browser edge",
    "test:auth": "cypress run --spec \"cypress/e2e/auth/**\"",
    "test:pim": "cypress run --spec \"cypress/e2e/pim/**\"",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@types/node": "^20.17.0",
    "cypress": "^15.0.0",
    "cypress-mochawesome-reporter": "^3.8.2",
    "eslint": "^9.15.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.15.0"
  }
}
